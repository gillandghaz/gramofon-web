# Salin file ini menjadi ".env.local" (bukan ".env.local.example") lalu isi
# dengan nilai dari Firebase Console > Project Settings > Your apps.
# JANGAN pernah commit file ".env.local" ke Git — file ini sudah masuk .gitignore.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Server-side only (JANGAN pakai prefix NEXT_PUBLIC_ — ini rahasia,
# tidak boleh sampai terkirim ke browser). Dipakai oleh /api/admin/*
# untuk operasi admin (mis. hapus akun pengguna) lewat Firebase Admin SDK.
# Didapat dari: Firebase Console > Project Settings > Service Accounts >
# Generate new private key (lihat README).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---- Cloudinary (penyimpanan video/audio) — server-side only juga.
# Didapat dari Cloudinary Dashboard setelah daftar (lihat README):
# Dashboard > "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
