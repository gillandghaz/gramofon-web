rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Saklar admin "Izinkan pengguna hapus akun sendiri" (settings/app).
    // Default TRUE kalau dokumen/field-nya belum pernah di-set.
    function selfDeleteAllowed() {
      return !exists(/databases/$(database)/documents/settings/app) ||
        get(/databases/$(database)/documents/settings/app).data.selfDeleteEnabled != false;
    }

    // ---- users/{userId} : profil (email, displayName, username, role, photoURL, settings)
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user";

      // User biasa boleh update profilnya sendiri (nama, foto, settings, dll),
      // TAPI TIDAK PERNAH boleh menyentuh field "role" ATAU "username"
      // miliknya sendiri (username hanya boleh diubah admin, lihat di bawah).
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'username']);

      // Hanya admin yang boleh mengubah field "role" milik akun LAIN.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

      // Hanya admin yang boleh mengubah "username" milik user LAIN, dan
      // TIDAK BOLEH kalau target-nya sesama admin (proteksi antar-admin).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && resource.data.role != "admin";

      // Admin boleh mengubah username MILIKNYA SENDIRI juga.
      allow update: if isAdmin()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);

      // User boleh menghapus profilnya sendiri — TAPI HANYA kalau admin
      // belum menonaktifkan saklar "Izinkan pengguna hapus akun sendiri".
      allow delete: if isSignedIn() && request.auth.uid == userId && selfDeleteAllowed();

      // Admin boleh menghapus profil user LAIN yang BUKAN admin (dipakai
      // fitur admin "Hapus Akun" — penghapusan akun Auth-nya sendiri
      // terjadi di server lewat /api/admin/delete-user).
      allow delete: if isAdmin() && resource.data.role != "admin";
    }

    // ---- usernames/{username} : menjamin keunikan username.
    match /usernames/{username} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.uid == request.auth.uid) || isAdmin();
      // Dihapus oleh pemiliknya sendiri (hapus akun sendiri, kalau saklar
      // admin mengizinkan), atau oleh admin (mengganti/menghapus akun user lain).
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && selfDeleteAllowed());
      allow update: if false;
    }

    // ---- settings/app : status buka/tutup pendaftaran & saklar hapus-akun-sendiri.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- media/{mediaId} : entri video/musik (Fase 5).
    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
