rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Saklar admin "Izinkan pengguna hapus akun sendiri" (settings/app).
    function selfDeleteAllowed() {
      return !exists(/databases/$(database)/documents/settings/app) ||
        get(/databases/$(database)/documents/settings/app).data.selfDeleteEnabled != false;
    }

    // Bentuk dokumen playlist yang diizinkan: hanya field yang memang dipakai
    // aplikasi, nama string <= 100 karakter, dan trackIds list <= 2000 item
    // (mencegah dokumen dibengkakkan sampai mendekati batas 1MB Firestore).
    function validPlaylist(d) {
      return d.keys().hasOnly(['uid', 'name', 'trackIds', 'createdAt', 'order'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.trackIds is list && d.trackIds.size() <= 2000;
    }

    // ---- users/{userId} : profil (email, displayName, username, role,
    // photoURL, settings, storageLimitMB, readNotifications)
    match /users/{userId} {
      // Hanya pemilik profil atau admin. (Sebelumnya semua user yang login
      // bisa membaca seluruh profil user lain, termasuk email.)
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // storageLimitMB TIDAK boleh diisi sendiri saat membuat profil —
      // hanya admin yang boleh menentukan kuota (lihat rule update admin).
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user"
        && !request.resource.data.keys().hasAny(['storageLimitMB', 'photoURL', 'photoPublicId']);

      // User biasa boleh update profilnya sendiri (nama, settings,
      // readNotifications, dll), TAPI TIDAK PERNAH boleh menyentuh field
      // "role", "username", "storageLimitMB" (kuota) ATAU "photoURL" /
      // "photoPublicId" miliknya sendiri. Foto profil disimpan di
      // Cloudinary dan HANYA ditulis server (/api/profile/photo/confirm)
      // setelah file-nya diverifikasi -- sehingga Firestore tidak pernah
      // menampung gambar (base64) maupun URL sembarang dari klien.
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'username', 'storageLimitMB', 'photoURL', 'photoPublicId']);

      // Admin boleh mengubah field "role" milik akun mana pun (termasuk
      // sesama admin — untuk mencabut status admin akun lain).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

      // Admin boleh mengubah "username" milik akun mana pun, TERMASUK
      // sesama admin (sesuai permintaan terbaru — proteksi antar-admin
      // yang tadinya ada sudah dicabut).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);

      // Admin boleh menetapkan/menghapus batas penyimpanan khusus akun
      // mana pun (dipakai fitur "Batas Penyimpanan" & reset massal).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storageLimitMB']);

      // User boleh menghapus profilnya sendiri — HANYA kalau saklar admin
      // "Izinkan pengguna hapus akun sendiri" masih menyala.
      allow delete: if isSignedIn() && request.auth.uid == userId && selfDeleteAllowed();

      // Admin boleh menghapus profil akun LAIN mana pun (termasuk sesama
      // admin, sesuai permintaan terbaru) — TAPI TIDAK boleh memakai jalur
      // ini untuk menghapus akunnya SENDIRI (supaya tidak jadi celah buat
      // melewati saklar selfDeleteAllowed di atas). Penghapusan akun Auth
      // sungguhan terjadi di server lewat /api/admin/delete-user.
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ---- usernames/{username} : menjamin keunikan username.
    match /usernames/{username} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid && selfDeleteAllowed());
      allow update: if false;
    }

    // ---- settings/app : status pendaftaran, saklar hapus-akun-sendiri,
    // dan batas penyimpanan default.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- notifications/{notifId} : pesan satu-arah admin -> semua user
    // ATAU ke pengguna tertentu (field targetUids: array uid, atau null
    // berarti broadcast). PENTING: karena "security rules bukan filter"
    // (lihat catatan di NotificationBell.js), pengguna biasa HARUS query
    // dengan where() yang cocok persis salah satu cabang di bawah --
    // query longgar seperti "ambil semua notifications" akan DITOLAK
    // TOTAL untuk non-admin, bukan cuma difilter sebagian. Ini yang
    // membuat notifikasi bertarget benar-benar tidak terbaca oleh
    // pengguna lain, bukan cuma disembunyikan di UI.
    match /notifications/{notifId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.targetUids == null)
        || (isSignedIn() && resource.data.targetUids is list
            && resource.data.targetUids.hasAny([request.auth.uid]));
      allow create, update, delete: if isAdmin();
    }

    // ---- media/{mediaId} : entri video/musik milik masing-masing user.
    match /media/{mediaId} {
      // Hanya pemilik atau admin. Query user biasa HARUS memakai
      // where("uid","==",uid_saya) — sudah begitu di lib/media.js.
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // SEMUA penulisan (create/update/delete) hanya lewat server
      // (/api/media/confirm-upload dan /api/media/delete, memakai Admin SDK
      // yang tidak terikat rules). Klien TIDAK boleh menulis langsung:
      //  - create langsung = bisa memalsukan "bytes" (kuota) dan "publicId"
      //    milik orang lain, lalu memicu penghapusan file orang itu lewat
      //    /api/media/delete;
      //  - delete langsung = menghapus catatan tanpa menghapus file di
      //    Cloudinary (file tetap tersimpan, kuota terlihat kosong).
      allow create, update, delete: if false;
    }

    // ---- exploreMedia/{mediaId} : media publik yang dikurasi admin.
    // Pengguna biasa TIDAK membaca koleksi ini langsung: daftar Explore
    // disajikan oleh server (/api/explore/list), yang membuang media
    // berstatus hidden sebelum dikirim -- supaya media yang disembunyikan
    // admin tidak pernah sampai ke browser pengguna lain. Semua penulisan
    // (upload, hapus, thumbnail, kategori, hidden/visible) juga lewat
    // server dengan Admin SDK, jadi klien tidak boleh menulis sama sekali.
    match /exploreMedia/{mediaId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---- playlists/{playlistId} : playlist pribadi tiap pengguna.
    // PENTING: rule di bawah bergantung pada resource.data.uid, jadi
    // SETIAP query List HARUS dibatasi where("uid","==",uid_saya) di
    // client (lihat playlists.js) -- persis pola yang sama dengan
    // notifications/{notifId} di atas ("rules bukan filter").
    match /playlists/{playlistId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      // uid tidak boleh dipindah ke akun lain saat update.
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && validPlaylist(request.resource.data);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && validPlaylist(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
